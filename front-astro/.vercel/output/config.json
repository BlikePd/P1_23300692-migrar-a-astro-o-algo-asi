{
	"version": 3,
	"routes": [
		{
			"src": "^/_astro(?:/(.*))$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/categorias/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/facturas/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/inventario/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/pagos/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/pedidos/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/productos/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/usuarios/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/?$",
			"dest": "_render"
		},
		{
			"src": "^/carrito/?$",
			"dest": "_render"
		},
		{
			"src": "^/checkout/?$",
			"dest": "_render"
		},
		{
			"src": "^/login/?$",
			"dest": "_render"
		},
		{
			"src": "^/me-gusta/?$",
			"dest": "_render"
		},
		{
			"src": "^/pedidos/?$",
			"dest": "_render"
		},
		{
			"src": "^/producto/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/recuperar-contrasena/?$",
			"dest": "_render"
		},
		{
			"src": "^/registro/?$",
			"dest": "_render"
		},
		{
			"src": "^/restablecer-contrasena/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render"
		}
	]
}